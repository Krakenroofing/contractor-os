{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "next-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "next-demo",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:NEXT_PUBLIC_SUPABASE_ANON_KEY=' '; npm run dev -- -p $env:PORT"
      ],
      "port": 3001,
      "autoPort": true
    }
  ]
}
