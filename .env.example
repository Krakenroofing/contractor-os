# =====================================================================
# Contractor OS environment variables
# =====================================================================
#
# DEMO MODE (no setup required):
#   Leave everything below commented out. Run `npm install` && `npm run dev`
#   and open http://localhost:3000. All data lives in an in-memory mock store
#   and is reset every time the dev server restarts.
#
# REAL DATABASE MODE (Supabase / Postgres):
#   Copy this file to `.env.local`, fill in DATABASE_URL, restart the dev
#   server. The 4 foundation entities (companies / customers / projects /
#   vendors) will read & write the database; everything else (estimates,
#   proposals, invoices, payments, job costing) keeps using the mock store
#   for now and will be phased onto the database next.
#
#   To populate the new database with the same demo seed data, run:
#     npm run db:seed
#
# Never commit `.env.local` — it's git-ignored by default in Next.js.
# =====================================================================

# ---------- Drizzle / Postgres direct connection ----------
# Use the "Connection string" → "Transaction pooler" value from your Supabase
# project (Project Settings → Database → Connection string). The transaction
# pooler is fine here because Drizzle's postgres-js driver is set to
# `prepare: false`.
#
# Example:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres

# ---------- Supabase JS client (used for Auth/Storage later) ----------
# Both keys are visible in Supabase dashboard → Project Settings → API.
# NEXT_PUBLIC_SUPABASE_URL and the ANON_KEY are safe to ship to the browser.
# SERVICE_ROLE_KEY must stay server-side ONLY.
#
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ---------- Optional: pin the active company / user during development ----------
# DEV_COMPANY_ID=
# DEV_USER_ID=
